    "@react-three/postprocessing": "^3.1.3",
    "@roundtrip/agent": "workspace:*",
    "@roundtrip/core": "workspace:*",
    "@sentry/nextjs": "11.4.0",
    "@serwist/turbopack": "9.5.13",
    "@tanstack/react-query": "^5.104.1",
