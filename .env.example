CLOUDFLARE_ACCOUNT_ID=     # Cloudflare dashboard, Workers AI, REST API
CLOUDFLARE_API_TOKEN=      # Cloudflare API token with Workers AI permission
OPENROUTER_API_KEY=        # openrouter.ai, free Gemma 4 fallback
TABPFN_TOKEN=              # ux.priorlabs.ai, API Keys
HF_TOKEN=                  # huggingface.co/settings/tokens, write access
GEMINI_API_KEY=            # optional, only if your AI Studio key works

# Services
SERPAPI_API_KEY=           # serpapi.com dashboard
MONGODB_URI=               # Atlas free cluster connection string
RENDER_API_KEY=            # Render account settings, API Keys
SENTRY_DSN=                # Sentry project settings, Client Keys (DSN)
AGENTMAIL_API_KEY=         # AgentMail console
ELEVENLABS_API_KEY=        # optional, elevenlabs.io profile, API Keys

# Diary encryption
DIARY_ENCRYPTION_KEY=      # run `openssl rand -base64 32` yourself and paste the output

# Limits and demo settings
